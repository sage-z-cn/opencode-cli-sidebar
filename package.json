{
  "name": "opencode-cli-sidebar",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "5.6.4",
  "publisher": "sagez",
  "icon": "icon.png",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "terminal",
    "tui",
    "sidebar",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sage-z-cn/opencode-cli-sidebar.git"
  },
  "license": "MIT",
  "author": {
    "name": "sagez"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode-cli-sidebarContainer",
          "title": "%views.container.title%",
          "icon": "resources/activity-bar.svg"
        }
      ]
    },
    "views": {
      "opencode-cli-sidebarContainer": [
        {
          "id": "opencode-cli-sidebar-view",
          "name": "%views.terminal.name%",
          "type": "webview",
          "icon": "resources/activity-bar.svg",
          "initialOrder": 1
        }
      ]
    },
    "commands": [
      {
        "command": "opencode-cli-sidebar.start",
        "title": "%command.opencode-cli-sidebar.start.title%",
        "category": "%command.category.opencode-cli-sidebar%"
      },
      {
        "command": "opencode-cli-sidebar.focus",
        "title": "%command.opencode-cli-sidebar.focus.title%"
      },
      {
        "command": "opencode-cli-sidebar.sendToTerminal",
        "title": "%command.opencode-cli-sidebar.sendToTerminal.title%",
        "category": "%command.category.opencode-cli-sidebar%"
      },
      {
        "command": "opencode-cli-sidebar.sendAtMention",
        "title": "%command.opencode-cli-sidebar.sendAtMention.title%",
        "category": "%command.category.opencode-cli-sidebar%"
      },
      {
        "command": "opencode-cli-sidebar.sendAllOpenFiles",
        "title": "%command.opencode-cli-sidebar.sendAllOpenFiles.title%",
        "category": "%command.category.opencode-cli-sidebar%"
      },
      {
        "command": "opencode-cli-sidebar.sendToOpencode",
        "title": "%command.opencode-cli-sidebar.sendToOpencode.title%",
        "category": "%command.category.opencode-cli-sidebar%"
      },
      {
        "command": "opencode-cli-sidebar.sendAbsoluteToOpencode",
        "title": "%command.opencode-cli-sidebar.sendAbsoluteToOpencode.title%",
        "category": "%command.category.opencode-cli-sidebar%"
      },
      {
        "command": "opencode-cli-sidebar.paste",
        "title": "%command.opencode-cli-sidebar.paste.title%",
        "category": "%command.category.opencode-cli-sidebar%",
        "icon": "$(clippy)"
      },
      {
        "command": "opencode-cli-sidebar.checkOpenCodeUpdates",
        "title": "%command.opencode-cli-sidebar.checkOpenCodeUpdates.title%",
        "category": "%command.category.opencode-cli-sidebar%"
      },
      {
        "command": "opencode-cli-sidebar.webdavSyncNow",
        "title": "%command.opencode-cli-sidebar.webdavSyncNow.title%",
        "category": "%command.category.opencode-cli-sidebar%"
      }
    ],
    "menus": {
      "view/title": [],
      "explorer/context": [
        {
          "command": "opencode-cli-sidebar.sendToOpencode",
          "group": "0_opencode_cli_sidebar@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "opencode-cli-sidebar.sendToOpencode",
          "group": "0_opencode_cli_sidebar@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "opencode-cli-sidebar.sendAbsoluteToOpencode",
          "group": "0_opencode_cli_sidebar@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "opencode-cli-sidebar.sendAbsoluteToOpencode",
          "group": "0_opencode_cli_sidebar@2",
          "when": "explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "opencode-cli-sidebar.sendAtMention",
          "group": "0_opencode_cli_sidebar"
        }
      ],
      "editor/title/context": [
        {
          "command": "opencode-cli-sidebar.sendToOpencode",
          "when": "resourceScheme == file",
          "group": "1_cm_opencode_cli_sidebar"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode-cli-sidebar.sendAtMention",
        "key": "alt+a",
        "mac": "alt+a",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "opencode-cli-sidebar.sendAllOpenFiles",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "opencode-cli-sidebar.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == 'opencode-cli-sidebar-view'"
      },
      {
        "command": "-workbench.action.quickOpen",
        "key": "ctrl+p",
        "when": "focusedView == 'opencode-cli-sidebar-view'"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "opencode-cli-sidebar.fontSize": {
          "type": "number",
          "default": 12,
          "minimum": 6,
          "maximum": 25,
          "description": "%configuration.opencode-cli-sidebar.fontSize.description%"
        },
        "opencode-cli-sidebar.fontFamily": {
          "type": "string",
          "default": "'JetBrainsMono Nerd Font', 'FiraCode Nerd Font', 'CascadiaCode NF', Menlo, monospace",
          "description": "%configuration.opencode-cli-sidebar.fontFamily.description%"
        },
        "opencode-cli-sidebar.cursorBlink": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.cursorBlink.description%"
        },
        "opencode-cli-sidebar.cursorStyle": {
          "type": "string",
          "default": "block",
          "enum": [
            "block",
            "underline",
            "bar"
          ],
          "description": "%configuration.opencode-cli-sidebar.cursorStyle.description%"
        },
        "opencode-cli-sidebar.focusIndicatorMode": {
          "type": "string",
          "default": "bottomBorder",
          "enum": [
            "off",
            "bottomBorder",
            "fullBorder"
          ],
          "description": "%configuration.opencode-cli-sidebar.focusIndicatorMode.description%"
        },
        "opencode-cli-sidebar.focusIndicatorBorderWidth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "%configuration.opencode-cli-sidebar.focusIndicatorBorderWidth.description%"
        },
        "opencode-cli-sidebar.scrollback": {
          "type": "number",
          "default": 10000,
          "minimum": 0,
          "maximum": 100000,
          "description": "%configuration.opencode-cli-sidebar.scrollback.description%"
        },
        "opencode-cli-sidebar.autoFocusOnSend": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.autoFocusOnSend.description%"
        },
        "opencode-cli-sidebar.autoStartOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.autoStartOnOpen.description%"
        },
        "opencode-cli-sidebar.shellPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.opencode-cli-sidebar.shellPath.description%"
        },
        "opencode-cli-sidebar.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.opencode-cli-sidebar.shellArgs.description%"
        },
        "opencode-cli-sidebar.sendKeybindingsToShell": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.sendKeybindingsToShell.description%"
        },
        "opencode-cli-sidebar.autoShareContext": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.autoShareContext.description%"
        },
        "opencode-cli-sidebar.httpTimeout": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "%configuration.opencode-cli-sidebar.httpTimeout.description%"
        },
        "opencode-cli-sidebar.enableHttpApi": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.enableHttpApi.description%"
        },
        "opencode-cli-sidebar.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "%configuration.opencode-cli-sidebar.logLevel.description%"
        },
        "opencode-cli-sidebar.contextDebounceMs": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "%configuration.opencode-cli-sidebar.contextDebounceMs.description%"
        },
        "opencode-cli-sidebar.maxDiagnosticLength": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 2000,
          "description": "%configuration.opencode-cli-sidebar.maxDiagnosticLength.description%"
        },
        "opencode-cli-sidebar.enableAutoSpawn": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.enableAutoSpawn.description%"
        },
        "opencode-cli-sidebar.codeActionSeverities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "information",
              "hint"
            ]
          },
          "default": [
            "error",
            "warning"
          ],
          "description": "%configuration.opencode-cli-sidebar.codeActionSeverities.description%"
        },
        "opencode-cli-sidebar.opencode.commandPath": {
          "type": "string",
          "default": "opencode",
          "description": "%configuration.opencode-cli-sidebar.opencode.commandPath.description%"
        },
        "opencode-cli-sidebar.opencode.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.opencode-cli-sidebar.opencode.args.description%"
        },
        "opencode-cli-sidebar.opencode.continueLastSession": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.opencode.continueLastSession.description%"
        },
        "opencode-cli-sidebar.update.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.update.autoCheck.description%"
        },
        "opencode-cli-sidebar.update.checkIntervalHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "%configuration.opencode-cli-sidebar.update.checkIntervalHours.description%"
        },
        "opencode-cli-sidebar.sync.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.opencode-cli-sidebar.sync.enabled.description%"
        },
        "opencode-cli-sidebar.sync.url": {
          "type": "string",
          "default": "",
          "description": "%configuration.opencode-cli-sidebar.sync.url.description%"
        },
        "opencode-cli-sidebar.sync.username": {
          "type": "string",
          "default": "",
          "description": "%configuration.opencode-cli-sidebar.sync.username.description%"
        },
        "opencode-cli-sidebar.sync.basePath": {
          "type": "string",
          "default": "/opencode-config/",
          "description": "%configuration.opencode-cli-sidebar.sync.basePath.description%"
        },
        "opencode-cli-sidebar.sync.allowInsecureHttp": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.opencode-cli-sidebar.sync.allowInsecureHttp.description%"
        },
        "opencode-cli-sidebar.sync.acceptSelfSigned": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.opencode-cli-sidebar.sync.acceptSelfSigned.description%"
        },
        "opencode-cli-sidebar.sync.autoSyncEnabled": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.opencode-cli-sidebar.sync.autoSyncEnabled.description%"
        },
        "opencode-cli-sidebar.sync.autoSyncOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.sync.autoSyncOnStartup.description%"
        },
        "opencode-cli-sidebar.sync.autoSyncOnLocalChange": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.sync.autoSyncOnLocalChange.description%"
        },
        "opencode-cli-sidebar.sync.autoSyncRemotePoll": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.sync.autoSyncRemotePoll.description%"
        },
        "opencode-cli-sidebar.sync.pollIntervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "step": 1,
          "description": "%configuration.opencode-cli-sidebar.sync.pollIntervalMinutes.description%"
        },
        "opencode-cli-sidebar.sync.rateLimitMaxRequests": {
          "type": "number",
          "default": 600,
          "description": "%configuration.opencode-cli-sidebar.sync.rateLimitMaxRequests.description%"
        },
        "opencode-cli-sidebar.sync.rateLimitWindowMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "%configuration.opencode-cli-sidebar.sync.rateLimitWindowMinutes.description%"
        },
        "opencode-cli-sidebar.sync.showStatusIcon": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.opencode-cli-sidebar.sync.showStatusIcon.description%"
        },
        "opencode-cli-sidebar.sync.customItems": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.opencode-cli-sidebar.sync.customItems.description%"
        },
        "opencode-cli-sidebar.sync.disabledItems": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.opencode-cli-sidebar.sync.disabledItems.description%"
        },
        "opencode-cli-sidebar.sync.excludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.opencode-cli-sidebar.sync.excludedPaths.description%"
        },
        "opencode-cli-sidebar.sync.onConflict": {
          "type": "string",
          "enum": [
            "prompt",
            "preferLocal",
            "preferRemote"
          ],
          "default": "prompt",
          "description": "%configuration.opencode-cli-sidebar.sync.onConflict.description%"
        },
        "opencode-cli-sidebar.sync.deletions": {
          "type": "string",
          "enum": [
            "prompt",
            "ignore",
            "propagate"
          ],
          "default": "prompt",
          "description": "%configuration.opencode-cli-sidebar.sync.deletions.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack",
    "compile:e2e": "tsc -p tsconfig.e2e.json",
    "watch": "webpack --watch",
    "package": "node scripts/build.js",
    "publish": "node scripts/build.js --publish --install",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,md}\"",
    "test": "vitest run",
    "pretest:e2e": "npm run compile && npm run compile:e2e",
    "test:e2e": "vscode-test",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "install-ext": "node scripts/build.js --install"
  },
  "dependencies": {
    "node-pty": "^1.2.0-beta.11"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.13",
    "@types/vscode": "^1.106.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^29.0.1",
    "lucide": "^1.61.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.0",
    "ws": "^8.21.0"
  }
}
